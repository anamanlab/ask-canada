# Model (pick one). Without either, the app uses Vercel AI Gateway via OIDC (vercel env pull).
# ANTHROPIC_API_KEY=
# AI_MODEL=anthropic/claude-sonnet-5.5

# Deterministic scripted answers (no model). Set to 1 for demos, screenshots or as a kill switch.
# SCRIPTED_AI=1

# Country pack (default ca)
# COUNTRY=ca

# --- Abuse and cost controls (all optional; docs/DEPLOY.md "Abuse and cost controls") ---

# Per-IP rate limit on /api/chat: token bucket in memory, per instance.
# RATE_LIMIT_PER_MINUTE=8
# RATE_LIMIT_BURST=12
# RATE_LIMIT_SALT=change-me
# Proxies you control in front of the app (each appends to X-Forwarded-For). Vercel or one load balancer: 1.
# TRUSTED_PROXY_HOPS=1
# Throttle in `next dev` too (off by default).
# RATE_LIMIT_DEV=1

# Shared rate limit across instances. Pick one:
#  - Vercel only: the "Rate limit ID" of a @vercel/firewall rule created in the dashboard (Firewall -> Rules).
# RATE_LIMIT_FIREWALL_ID=chat
#  - Any host: Redis with an Upstash-compatible REST API (also makes the daily budget counter exact).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Daily spend circuit breaker: once today's estimated model spend (UTC day) reaches this many US dollars,
# answers come from the scripted engine until 00:00 UTC. Unset or 0 = off.
# AI_DAILY_BUDGET_USD=25
# Prices (USD per million tokens) for a model that is not in src/lib/ai/pricing.ts, e.g. an Azure deployment.
# AI_PRICE_INPUT=2
# AI_PRICE_OUTPUT=10
# AI_PRICE_CACHE_READ=0.2
# AI_PRICE_CACHE_WRITE=2.5

# Per-request caps (defaults shown).
# AI_MAX_INPUT_CHARS=4000
# AI_MAX_HISTORY=24
# AI_MAX_CONTEXT_CHARS=240000
# AI_MAX_STEPS=6
# AI_MAX_OUTPUT_TOKENS=3000   # per step; doubled for scripts that cost more tokens per word
# AI_WEB_SEARCH_MAX_USES=3
# AI_MAX_ANSWER_MS=55000
# AI_SOFT_ANSWER_MS=26000     # after this, no further lookups: the answer is written with what is there
# AI_TOOL_TIMEOUT_MS=12000     # time budget for one tool call
# AI_EFFORT=medium             # low | medium | high: how much Claude 5.5 models think before writing
# AI_TURN_LOG=0                # turn off the one-line-per-answer JSON log

# Vercel BotID on POST /api/chat (only on Vercel; ignored everywhere else).
#   scripted (default): bots get scripted answers, never the model | deny: 403 | log: classify only | off
# BOTID_MODE=scripted
# Verified bots (names or categories from bots.fyi) that are treated as people. Empty = none.
# BOTID_ALLOW_VERIFIED=chatgpt-operator,google-agent
