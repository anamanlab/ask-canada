{
  "name": "canada",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/fr-typography.mjs",
    "check:typography": "node scripts/fr-typography.mjs",
    "check:scenarios": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-scenarios.mjs",
    "check:guards": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-abuse-guards.mjs",
    "check:providers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-providers.mjs",
    "art": "node scripts/build-art.mjs",
    "shot": "node scripts/shot.mjs",
    "typecheck:br": "tsc --noEmit -p tsconfig.br.json",
    "check:i18n:br": "node scripts/check-i18n.mjs --country br",
    "check:scenarios:br": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-scenarios.mjs --country br",
    "art:br": "node scripts/build-art.br.mjs",
    "test:br:holidays": "node src/countries/br/data/holidays.test.mjs",
    "generate:br": "node src/countries/br/knowledge/guidance/render.mjs && node src/countries/br/messages/render.mjs && node src/countries/br/widgets/holidays/messages/render.mjs && node src/countries/br/scenarios/render-starters.mjs",
    "servicos:br": "node scripts/fetch-servicos.mjs",
    "servicos:br:check": "node scripts/fetch-servicos.mjs --check",
    "test:br:servicos": "node src/countries/br/knowledge/servicos.test.mjs",
    "test:br:contract": "node src/countries/br/tools/contract.test.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "cf deploy",
    "probe:workers-ai": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/probe-workers-ai.mjs"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.102",
    "@ai-sdk/anthropic": "^4.0.69",
    "@ai-sdk/azure": "^4.0.86",
    "@ai-sdk/gateway": "^4.0.101",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/react": "^4.0.126",
    "@vercel/analytics": "^2.0.1",
    "@vercel/firewall": "^1.2.5",
    "@vercel/functions": "^3.9.9",
    "@vinext/cloudflare": "^1.0.1",
    "ai": "^7.0.123",
    "botid": "^1.5.11",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.3.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "vinext": "^1.0.1",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "babel-plugin-react-compiler": "^1.0.0",
    "cf": "1.0.0-beta.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "playwright": "1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.0"
  },
  "packageManager": "pnpm@10.28.2",
  "type": "module"
}
